# ==================== LLM & Embedding ====================
# OpenAI-compatible LLM configuration（必填）
LLM_API_KEY=your-llm-api-key
DASHSCOPE_API_KEY=your-llm-api-key
OPENAI_API_KEY=your-llm-api-key
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
DASHSCOPE_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL=your-model-name
DEFAULT_MODEL=your-model-name
DASHSCOPE_MODEL=your-model-name
OPENAI_MODEL=your-model-name
ARCHITECT_MODEL=your-model-name
SCOUT_MODEL=your-model-name
DATA_ANALYST_MODEL=your-model-name
EVIDENCE_EXTRACTOR_MODEL=your-model-name
WIZARD_MODEL=your-model-name
CRITIC_MODEL=your-model-name
WRITER_MODEL=your-model-name
EMBEDDING_MODEL=your-embedding-model-name
DEEP_RESEARCH_TRACE_ENABLED=true
DEEP_RESEARCH_TRACE_DIR=

# ==================== OpenRouter API ====================
# OpenRouter API Key（可选，用于多模型支持）
# 申请地址: https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key

# ==================== 文档解析 (DocMind) ====================
# 阿里云 DocMind 文档解析服务（可选）
# 申请地址: https://help.aliyun.com/zh/ram/user-guide/create-an-accesskey-pair
DOCMIND_ACCESS_KEY_ID=your-access-key-id
DOCMIND_ACCESS_KEY_SECRET=your-access-key-secret

# ==================== 搜索 API ====================
# 默认搜索提供方：tavily / bocha
SEARCH_PROVIDER=tavily

# Tavily 搜索 API（默认）
TAVILY_API_KEY=your-tavily-api-key

# 博查搜索 API（可选兜底）
# 申请地址: https://open.bochaai.com/
BOCHA_API_KEY=your-bocha-api-key

# Serper 搜索 API（可选）
SERPER_API_KEY=your-serper-api-key

# ==================== 行业资讯 API ====================
# 聚合数据 - 股票行情 API（可选）
# 申请地址: https://www.juhe.cn/docs/api/id/21
JUHE_STOCK_API_KEY=your-juhe-stock-api-key

# ==================== 招投标 API ====================
# 阿里云市场 - 招投标信息 API（可选）
# 申请地址: https://market.aliyun.com/detail/cmapi00063550
BID_APP_KEY=your-bid-app-key
BID_APP_SECRET=your-bid-app-secret
BID_APP_CODE=your-bid-app-code

# ==================== Redis ====================
# Docker 默认配置，通常无需修改
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== PostgreSQL ====================
# Docker 默认配置，与 docker-compose.yml 保持一致
# 如果使用 Docker，无需修改以下配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=industry_assistant

# ==================== Milvus ====================
# Docker 默认配置，通常无需修改
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ==================== JWT 认证 ====================
# 建议生成一个随机密钥，生产环境务必修改
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 其他配置 ====================
MEM_LIMIT=8073741824
TIMEZONE=Asia/Shanghai
